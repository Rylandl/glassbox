+
+
+def test_position_precision_tracks_target_radius_and_preserves_default():
+    from dataclasses import replace
+
+    states = jnp.zeros((4, 13)).at[:, 6].set(1).at[:, 2].set(1)
+    states = states.at[-1, 1].set(0.001)
+    commands = jnp.full((3, 4), 0.65)
+    target = Target()
+
+    def gradient(radius):
+        return jax.grad(
+            lambda x: strike_cost(x, commands, replace(target, radius_m=radius))
+        )(states)
+
+    default = gradient(0.02)
+    tighter = gradient(0.001)
+    wider = gradient(0.2)
+    np.testing.assert_allclose(default[-1, 1], 20.0, rtol=1e-6)
+    np.testing.assert_allclose(tighter[-1, 1], 400 * default[-1, 1], rtol=1e-6)
+    np.testing.assert_array_equal(wider, default)
