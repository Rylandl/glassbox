+def test_position_precision_tracks_target_radius_and_preserves_default():
+    from dataclasses import replace
+
+    states = jnp.zeros((4, 13)).at[:, 6].set(1).at[:, 2].set(1)
+    states = states.at[-1, 1].set(0.001)
+    commands = jnp.full((3, 4), 0.65)
+    target = Target()
+
+    def gradient(radius):
+        return jax.grad(
+            lambda x: strike_cost(x, commands, replace(target, radius_m=radius))
+        )(states)
+
+    default = gradient(0.02)
+    tighter = gradient(0.001)
+    wider = gradient(0.2)
+    np.testing.assert_allclose(default[-1, 1], 20.0, rtol=1e-6)
+    np.testing.assert_allclose(tighter[-1, 1], 400 * default[-1, 1], rtol=1e-6)
+    np.testing.assert_array_equal(wider, default)
+
+
+def test_radius_does_not_tighten_normal_depth_for_oblique_plane():
+    from dataclasses import replace
+
+    normal = np.array([2.0, -3.0, 4.0]) / np.sqrt(29.0)
+    target = Target(normal=tuple(normal))
+    states = jnp.zeros((4, 13)).at[:, 6].set(1).at[:, 2].set(1)
+    states = states.at[-1, :3].set(jnp.array([0.652, 0.003, 0.958]))
+    commands = jnp.full((3, 4), 0.65)
+
+    def gradient(radius):
+        return np.asarray(
+            jax.grad(
+                lambda x: strike_cost(x, commands, replace(target, radius_m=radius))
+            )(states)[-1, :3]
+        )
+
+    default, tight = gradient(0.02), gradient(0.001)
+    np.testing.assert_allclose(tight @ normal, default @ normal, rtol=2e-4)
+
+    def tangent(g):
+        return g - (g @ normal) * normal
+
+    np.testing.assert_allclose(tangent(tight), 400 * tangent(default), rtol=2e-5)
+    point_delta = (
+        np.array([0.652, 0.003, 0.998]) - np.asarray(target.center) + 0.002 * normal
+    )
+    np.testing.assert_allclose(default, 2 * point_delta / 0.01**2, atol=0.001)
